# Copy to .env and fill in.
NODE_ENV=production
PORT=8080
DATABASE_URL=postgres://pines:CHANGE_ME@localhost:5432/pines
# Long random string, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=CHANGE_ME
JWT_TTL=12h
APP_TZ=Asia/Kolkata
# Where uploaded dish photos are kept (must survive restarts / redeploys)
UPLOAD_DIR=./uploads
# Full address of this server, only if the pages are hosted on a different domain (makes photo URLs absolute)
PUBLIC_URL=
# Only needed if another web app on a different domain calls this API
CORS_ORIGINS=
# Behind nginx / a load balancer: number of proxies or "loopback"
TRUST_PROXY=loopback
MAX_PHOTO_MB=8
GUEST_ORDER_LIMIT=6
# Run migrations + seed at start-up (set false if your pipeline runs `npm run migrate` itself)
AUTO_MIGRATE=true
# PINs for the three starter logins created on the very first start only
SEED_ADMIN_PIN=1234
SEED_KITCHEN_PIN=1111
SEED_SERVICE_PIN=2222
